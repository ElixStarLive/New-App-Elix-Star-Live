# Elix Star Live — Environment Variables
# Copy to .env. NEVER commit .env.
# Production (Coolify): set these in the dashboard.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Neon / Postgres — required
DATABASE_URL=postgresql://user:password@localhost:5432/elix_star_live

# Auth — required (64+ hex chars in production)
JWT_SECRET=dev-only-change-me-to-a-64-char-random-secret-key-please!!

# Valkey/Redis — REQUIRED in production
# VALKEY_URL=redis://127.0.0.1:6379

LIVEKIT_URL=wss://your-livekit.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_HOSTNAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

APPLE_BUNDLE_ID=com.elixstarlive.app
APPLE_SIGN_IN_ENABLED=false
APPLE_IAP_ENVIRONMENT=Production
APPLE_IAP_NOTIFICATION_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.elixstarlive.app
GOOGLE_RTDN_WEBHOOK_SECRET=
TEST_COINS_ISSUE_PASSWORD=
ALLOW_TEST_COINS=false
SMTP_URL=
MAIL_FROM=noreply@elixstarlive.app

CLIENT_URL=http://localhost:5173
# Canonical client API owner is src/lib/api.ts. Do not set page-specific API URLs.
# Web localhost uses same-origin /api via the Vite proxy (this file's PORT=8080).
# `vite build --mode production` / store: always https://www.elixstarlive.co.uk on native.
# A Windows user env VITE_API_URL=http://127.0.0.1:8080 is stripped in production/store builds.
# Native USB debug may set VITE_API_URL=http://127.0.0.1:8080 only in a non-production Vite mode
# and only with: adb reverse tcp:8080 tcp:8080
VITE_API_URL=
VITE_WS_URL=
VITE_LIVEKIT_URL=
VITE_APPLE_SIGN_IN_ENABLED=false
# Login Forgot Password control. true only when transactional email is configured.
VITE_EMAIL_CONFIGURED=false
VITE_ENGAGEMENT_HUB_ENABLED=true
