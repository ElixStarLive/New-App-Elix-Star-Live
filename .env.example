# Elix Star Live — Environment Variables
# Copy to .env. NEVER commit .env.
# Production (Coolify): set these in the dashboard.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Neon / Postgres — required
DATABASE_URL=postgresql://user:password@localhost:5432/elix_star_live

# Auth — required (64+ hex chars in production)
JWT_SECRET=dev-only-change-me-to-a-64-char-random-secret-key-please!!

# Valkey/Redis — REQUIRED in production
# VALKEY_URL=redis://127.0.0.1:6379

LIVEKIT_URL=wss://your-livekit.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_HOSTNAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

APPLE_BUNDLE_ID=com.elixstarlive.app
APPLE_SIGN_IN_ENABLED=false
APPLE_IAP_ENVIRONMENT=Production
APPLE_IAP_NOTIFICATION_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.elixstarlive.app
GOOGLE_RTDN_WEBHOOK_SECRET=
TEST_COINS_ISSUE_PASSWORD=
ALLOW_TEST_COINS=false
SMTP_URL=
MAIL_FROM=noreply@elixstarlive.app

CLIENT_URL=http://localhost:5173
VITE_API_URL=
VITE_WS_URL=
VITE_LIVEKIT_URL=
VITE_APPLE_SIGN_IN_ENABLED=false
